{
  "submission": {
    "elements": [
      {
        "id": "E1",
        "name": "天空",
        "region": "上半部横贯全宽",
        "features": [
          {
            "id": "F1",
            "description": "画面上缘为深红色云雾状色场，向下逐渐变浅过渡到橙粉，色彩呈水平条带状柔和渐变，左右基本对称。"
          },
          {
            "id": "F2",
            "description": "太阳四周有一圈橙红色放射状光晕，以太阳为中心向外的亮度递减，柔和地隐入周围天空，无清晰外缘。"
          }
        ]
      },
      {
        "id": "E2",
        "name": "太阳",
        "region": "画面中上居中",
        "features": [
          {
            "id": "F3",
            "description": "太阳核心为一块白亮近圆形区域，中心几乎纯白，无可见表面细节。"
          },
          {
            "id": "F4",
            "description": "核心外围环绕一圈橙黄色光环，边缘柔化渐隐，亮度由内向外快速衰减。"
          },
          {
            "id": "F5",
            "description": "太阳底缘贴近地平线处有一条更亮的橙黄色光弧，并沿地平线向左右两侧略延展成低垂的亮带。"
          }
        ]
      },
      {
        "id": "E3",
        "name": "水面",
        "region": "下半部横贯全宽",
        "features": [
          {
            "id": "F6",
            "description": "水面与天空的交界为一条低对比的水平地平线，位置约在画面中部，轮廓模糊。"
          },
          {
            "id": "F7",
            "description": "中远景水面呈灰粉红的暗色基底，表面布满细密的水平波纹，纹理向远处收窄变细。"
          },
          {
            "id": "F8",
            "description": "前景水面颜色更暗，偏灰绿与深灰，波纹起伏加大并出现大块起伏的波面形态。"
          },
          {
            "id": "F9",
            "description": "沿画面垂直中轴有一条太阳倒影亮带：一串白色碎亮斑散布在波纹上，靠近地平线处细窄密集，向近处逐渐变宽变散。"
          },
          {
            "id": "F10",
            "description": "画面底部有一条横贯的深色大波脊，其上缘受光处形成细长弯曲的亮白高光边，局部最亮处接近纯白。"
          }
        ]
      }
    ],
    "context_notes": [
      "整图为暖色调海面日落/日出场景，画面上下分为天空与水面两大区域，无船只、云朵等其他可见物体。",
      "空气朦胧，远处低对比，水面远端与天空在地平线附近融合，颜色整体由上方深红过渡到水面灰粉与前景暗绿灰。"
    ],
