  "cards": [
    {
      "dot": "cyan",
      "title": "Agent 的运行阶段",
      "items": [
        "准备请求 → 等待模型响应 → 执行工具 → 处理反馈 → 准备下一次请求。",
        "模型选择回看时，执行目录查询或材料读取，再进入下一次模型调用。",
        "结束动作经业务规则确认后进入终态。读取与业务工具错误进入反馈处理。",
        "图中按需回看箭头包含读取工具的实际派发过程。"
      ]
    },
    {
      "dot": "emerald",
      "title": "内容怎样成为材料",
      "items": [
        "业务工具产出内容后，经保存与登记获得稳定材料 ID。",
        "登记关联内容类型、标签、来源动作和已有材料引用。",
        "原始内容与集中索引共同保存，裁剪材料关联来源和区域。",
        "登记回执将材料引用带回工具反馈，供后续直接回读。",
        "初始输入通过同一登记入口进入材料管理。"
      ]
    },
    {
      "dot": "violet",
      "title": "Agent 怎样找到并调用材料",
      "items": [
        "通过简短目录发现材料，也可直接使用历史反馈中的材料 ID。",
        "读取时选择整份正文、完整图像或局部区域，多份内容可一起对照。",
        "真实内容与来源进入模型请求，成功返回后按保留策略更新上下文。",
        "已登记、已读取、已进入请求及调用成功分别记录。"
      ]
    },
    {
      "dot": "amber",
      "title": "仍待讨论的规则",
      "items": [
        "材料分类维度、关联方式和目录组织。",
        "哪些材料默认展开，临时回看内容保留多久。",
        "写入触发点、读取接口及调用失败时的处理。",
        "本图描述目标运行关系，当前实现主要接入生成模块。"
      ]
    }
