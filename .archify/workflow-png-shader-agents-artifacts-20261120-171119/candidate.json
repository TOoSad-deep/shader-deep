  "cards": [
    {
      "dot": "emerald",
      "title": "谁在做",
      "items": [
        "绿色人物节点是工作角色。调参由生成角色按需派发，接收旧候选、允许改动的参数与保护区。",
        "独立评审给出画面差异和待补证项。"
      ]
    },
    {
      "dot": "violet",
      "title": "交出了什么",
      "items": [
        "紫色节点保存可交接的材料。E/F/R 交给假设角色，M 或 S 交给生成角色。",
        "评审报告交给主控；生成者选中的候选保留实际 PNG 和版本。"
      ]
    },
    {
      "dot": "amber",
      "title": "怎样进入下一轮",
      "items": [
        "齿盘只拍到中心时，补拍同一候选再评。完整入图但确实缺齿时，派发修订任务。",
        "自动调度是目标设计，现阶段由调用方决定。"
      ]
    }
  ]
}
