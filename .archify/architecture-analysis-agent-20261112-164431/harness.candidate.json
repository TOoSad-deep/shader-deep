  "cards": [
    {
      "dot": "cyan",
      "title": "两套角色各有五个工具",
      "items": [
        "观察使用 save_observation_draft、read_file、edit_file、finish_analysis、stop_analysis。",
        "规划使用 save_planning_draft、read_file、edit_file、finish_planning、stop_planning。",
        "FixedInput 限制模型可见工具，DraftToolGuard 再核查执行权限。写入分别限定到 /draft/observations.json 或 /draft/planning.json。"
      ]
    },
    {
      "dot": "emerald",
      "title": "保存、复核与局部修订",
      "items": [
        "首次保存完整 JSON。随后 read_file 回读，同一 Agent 对照固定材料复核，再用 edit_file 修正唯一匹配片段。",
        "磁盘字节哈希构成 revision。编辑使用请求绑定版本，同批工具按声明顺序执行，返回修改摘要与定位诊断。",
        "字段结构在写入前校验。跨条目业务问题可暂存，完成时统一校验。"
      ]
    },
    {
      "dot": "amber",
      "title": "完成必须通过版本门禁",
      "items": [
        "DraftReadTracker 累计同版本草稿实际进入成功主请求的全部行。每次修改后重新完整回读。",
        "下一轮模型响应才能调用无参数 finish。Session 执行领域校验，快照写入成功后标记 accepted。",
        "stop 或主调用预算耗尽保留草稿与原因。终态门禁先于后续摘要和主模型计数。"
      ]
    },
    {
      "dot": "violet",
      "title": "上下文与记忆归属",
      "items": [
        "主 SKILL 正文直接进入 system prompt。复杂边界参考预置到 StateBackend，通过 read_file 按需披露。",
        "SDK 管理本图消息、摘要及外置材料。Session 维护业务状态、版本和预算。磁盘记录草稿、历史字节与接受结果。",
        "当前观察和规划的记忆范围是各自本次运行。跨阶段通过正式文件包传递事实。"
      ]
    },
    {
      "dot": "slate",
      "title": "配置与源码依据",
      "items": [
        "观察和规划默认主模型调用预算均为 20。网络重试另计，显式 CLI 参数可以覆盖配置。",
        "观察 YAML 每次输出上限 163840，直接构造 AnalysisOptions 默认 16384。规划默认 32768。",
        "依据当前未提交工作树的独立本地证据快照。图中的模型节点表示环境变量配置的服务，实际型号随运行配置确定。"
      ]
    }
  ]
