  "cards": [
    {
      "dot": "cyan",
      "title": "三个公开入口",
      "items": [
        "run_analysis → run_planning → run_generation_from_planning",
        "调用方分别发起每一阶段。观察与规划各自拥有独立会话、草稿、调用预算和正式包。"
      ]
    },
    {
      "dot": "emerald",
      "title": "观察负责什么",
      "items": [
        "E 包含可见背景、对象或同类对象群。F 首次嵌套在 E 下提交，程序派生 feature_ids。",
        "R 表达同元素或跨元素的关键配合。context_notes、open_questions 与 gaps 单独保存。",
        "输出包包含 elements.json、features.json、relations.json、manifest.json、reference.png 和 README.md。"
      ]
    },
    {
      "dot": "violet",
      "title": "规划负责什么",
      "items": [
        "M 描述可复用构造方法与成立条件。S 维护 F/R 到方法组的选择，并通过 composition 组织完整场景。",
        "备选可替换局部选择，一次显式选用一项。候选索引由程序派生。",
        "正式包包含观察副本、要求、生成约束、M/S、组合候选和内容哈希。"
      ]
    },
    {
      "dot": "amber",
      "title": "完成与实际效果",
      "items": [
        "观察有必要 gaps 时交付 partial。规划至少有一套 S 与上游观察均无必要缺口时交付 completed。",
        "程序完成状态体现合同校验和已知缺口。图像质量继续通过实际生成、预览对照和人工确认。"
      ]
    },
    {
      "dot": "slate",
      "title": "源码依据",
