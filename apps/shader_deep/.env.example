# 配置优先级: OPENROUTER > DS_MICU > MICU; 任一项非空即整组选用, 不跨组补齐.
# 可选 OpenRouter 配置; 完整填写后优先使用该组.
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
OPENROUTER_API_KEY=
# 可选推理强度; 未配置时沿用模型默认, 支持值以所选模型目录为准.
# OPENROUTER_REASONING_EFFORT=low
# 可选选路优先级: price、throughput、latency; 未配置时沿用网关默认.
# OPENROUTER_PROVIDER_SORT=throughput

# 未配置 OpenRouter 时使用 DeepSeek 专用组.
DS_MICU_MODEL=
DS_MICU_BASE_URL=
DS_MICU_API_KEY=

# 兼容原 MICU 配置: 仅在上述三项全部为空时启用.
# MICU_MODEL=
# MICU_BASE_URL=
# MICU_API_KEY=

# 可选追踪: 填入 LangSmith 密钥后将开关改为 true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shader-deep
# 非默认区域请填写账户对应的 API 地址; 多工作区密钥按需填写工作区 ID.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
