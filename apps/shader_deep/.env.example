# 默认使用 DeepSeek 专用组, 填写其模型 ID、API 地址和对应密钥.
DS_MICU_MODEL=
DS_MICU_BASE_URL=
DS_MICU_API_KEY=

# 兼容原 MICU 配置: 仅在上述三项全部为空时启用.
# MICU_MODEL=
# MICU_BASE_URL=
# MICU_API_KEY=

# 可选追踪: 填入 LangSmith 密钥后将开关改为 true.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shader-deep
# 非默认区域请填写账户对应的 API 地址; 多工作区密钥按需填写工作区 ID.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_WORKSPACE_ID=
